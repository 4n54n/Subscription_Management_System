  CONFIRMED
  PAID
  CANCELLED
  OVERDUE
}

enum BrightloopDiscountType {
  FIXED
  PERCENTAGE
}

enum BrightloopPaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHEQUE
  ONLINE
}

model Product {
  id              String                @id @default(uuid()) @db.VarChar
  workspaceId     String                @map("workspace_id") @db.VarChar
  name            String                @db.VarChar
  productType     BrightloopProductType @default(SERVICE) @map("product_type")
  salesPrice      Decimal               @default(0.00) @map("sales_price") @db.Decimal(12, 2)
  costPrice       Decimal               @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  notes           String?               @db.Text
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants        ProductVariant[]
  quotationLines  QuotationLine[]
  subscriptionLines SubscriptionItem[]
  invoiceLines    InvoiceItem[]
  discounts       DiscountRule[]        @relation("ProductDiscounts")

  @@map("brightloop_products")
}

model ProductVariant {
  id              String          @id @default(uuid()) @db.VarChar
  productId       String          @map("product_id") @db.VarChar
  name            String          @db.VarChar // e.g. "Brand: Odoo"
  variantType     String          @default("brand") @map("variant_type") @db.VarChar
  priceAdjustment Decimal         @default(0.00) @map("price_adjustment") @db.Decimal(12, 2) // e.g. +560
  sku             String?         @db.VarChar
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines  QuotationLine[]
  subscriptionLines SubscriptionItem[]
  invoiceLines    InvoiceItem[]

  @@map("brightloop_product_variants")
}

model SubscriptionPlan {
  id               String                     @id @default(uuid()) @db.VarChar
  workspaceId      String                     @map("workspace_id") @db.VarChar
  name             String                     @db.VarChar
  description      String?                    @db.Text
  price            Decimal                    @default(0.00) @db.Decimal(12, 2)
  billingFrequency BrightloopBillingFrequency @default(MONTHLY) @map("billing_frequency")
  minQuantity      Int                        @default(1) @map("min_quantity")
  startDate        DateTime?                  @map("start_date") @db.Timestamptz(3)
  endDate          DateTime?                  @map("end_date") @db.Timestamptz(3)
  isActive         Boolean                    @default(true) @map("is_active")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotationTemplates QuotationTemplate[]
  subscriptions      BrightloopSubscription[]

  @@map("brightloop_subscription_plans")
}

model QuotationTemplate {
  id              String           @id @default(uuid()) @db.VarChar
  workspaceId     String           @map("workspace_id") @db.VarChar
  name            String           @db.VarChar
  description     String?          @db.Text
  planId          String?          @map("plan_id") @db.VarChar
  validityDays    Int              @default(30) @map("validity_days")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan            SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  lines           QuotationLine[]
  quotes          Quotation[]

  @@map("brightloop_quotation_templates")
}

model Quotation {
  id              String           @id @default(uuid()) @db.VarChar
  workspaceId     String           @map("workspace_id") @db.VarChar
  quotationNumber String           @unique @map("quotation_number") @db.VarChar
  templateId      String?          @map("template_id") @db.VarChar
  customerId      String           @map("customer_id") @db.VarChar
  planId          String?          @map("plan_id") @db.VarChar
  title           String           @db.VarChar
  validUntil      DateTime         @map("valid_until") @db.Timestamptz(3)
  paymentTerms    String           @default("Immediate Payment") @map("payment_terms") @db.VarChar
  status          String           @default("draft") @db.VarChar // draft, sent, confirmed, converted, expired, rejected
  notes           String?          @db.Text
  subtotal        Decimal          @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal          @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal          @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  convertedSubId  String?          @unique @map("converted_sub_id") @db.VarChar
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  template        QuotationTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customer        User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines           QuotationLine[]
  subscription    BrightloopSubscription? @relation("QuoteToSub")

  @@map("brightloop_quotations")
}

model QuotationLine {
  id              String           @id @default(uuid()) @db.VarChar
  quotationId     String?          @map("quotation_id") @db.VarChar
  templateId      String?          @map("template_id") @db.VarChar
  productId       String           @map("product_id") @db.VarChar
  variantId       String?          @map("variant_id") @db.VarChar
  quantity        Int              @default(1)
  unitPrice       Decimal          @map("unit_price") @db.Decimal(12, 2)
  taxRate         Decimal          @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal          @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(12, 2)

  quotation       Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  template        QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("brightloop_quotation_lines")
}

model BrightloopSubscription {
  id                  String                       @id @default(uuid()) @db.VarChar
  workspaceId         String                       @map("workspace_id") @db.VarChar
  subscriptionNumber  String                       @unique @map("subscription_number") @db.VarChar
  customerId          String                       @map("customer_id") @db.VarChar
  planId              String                       @map("plan_id") @db.VarChar
  quotationId         String?                      @unique @map("quotation_id") @db.VarChar
  status              BrightloopSubscriptionStatus @default(DRAFT)
  startDate           DateTime                     @map("start_date") @db.Timestamptz(3)
  expiryDate          DateTime?                    @map("expiry_date") @db.Timestamptz(3)
  nextBillingDate     DateTime                     @map("next_billing_date") @db.Timestamptz(3)
  lastInvoicedDate    DateTime?                    @map("last_invoiced_date") @db.Timestamptz(3)
  paymentTerms        String                       @default("Net 15") @map("payment_terms") @db.VarChar
  billingFrequency    BrightloopBillingFrequency   @default(MONTHLY) @map("billing_frequency")
  subtotal            Decimal                      @default(0.00) @db.Decimal(12, 2)
  taxAmount           Decimal                      @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount      Decimal                      @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount         Decimal                      @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  autoRenew           Boolean                      @default(true) @map("auto_renew")
  pausedAt            DateTime?                    @map("paused_at") @db.Timestamptz(3)
  closedAt            DateTime?                    @map("closed_at") @db.Timestamptz(3)
  closureReason       String?                      @map("closure_reason") @db.VarChar
  notes               String?                      @db.Text
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer            User                         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                SubscriptionPlan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotation           Quotation?                   @relation("QuoteToSub", fields: [quotationId], references: [id], onDelete: SetNull)
  items               SubscriptionItem[]
  invoices            BrightloopInvoice[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("brightloop_subscriptions")
}

model SubscriptionItem {
  id              String                 @id @default(uuid()) @db.VarChar
  subscriptionId  String                 @map("subscription_id") @db.VarChar
  productId       String                 @map("product_id") @db.VarChar
  variantId       String?                @map("variant_id") @db.VarChar
  quantity        Int                    @default(1)
  unitPrice       Decimal                @map("unit_price") @db.Decimal(12, 2)
  taxRate         Decimal                @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal                @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal                @map("total_amount") @db.Decimal(12, 2)

  subscription    BrightloopSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("brightloop_subscription_items")
}

model BrightloopInvoice {
  id                String                  @id @default(uuid()) @db.VarChar
  workspaceId       String                  @map("workspace_id") @db.VarChar
  invoiceNumber     String                  @unique @map("invoice_number") @db.VarChar
  subscriptionId    String?                 @map("subscription_id") @db.VarChar
  customerId        String                  @map("customer_id") @db.VarChar
  billingCycleStart DateTime                @map("billing_cycle_start") @db.Timestamptz(3)
  billingCycleEnd   DateTime                @map("billing_cycle_end") @db.Timestamptz(3)
  issueDate         DateTime                @default(now()) @map("issue_date") @db.Timestamptz(3)
  dueDate           DateTime                @map("due_date") @db.Timestamptz(3)
  status            BrightloopInvoiceStatus @default(DRAFT)
  subtotal          Decimal                 @default(0.00) @db.Decimal(12, 2)
  taxAmount         Decimal                 @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount    Decimal                 @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount       Decimal                 @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount        Decimal                 @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount     Decimal                 @default(0.00) @map("balance_amount") @db.Decimal(12, 2)
  paymentTerms      String                  @default("Net 15") @map("payment_terms") @db.VarChar
  notes             String?                 @db.Text
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription      BrightloopSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer          User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             InvoiceItem[]
  payments          PaymentRecord[]

  @@unique([subscriptionId, billingCycleStart, billingCycleEnd])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("brightloop_invoices")
}

model InvoiceItem {
  id              String            @id @default(uuid()) @db.VarChar
  invoiceId       String            @map("invoice_id") @db.VarChar
  productId       String            @map("product_id") @db.VarChar
  variantId       String?           @map("variant_id") @db.VarChar
  description     String?           @db.VarChar
  quantity        Int               @default(1)
  unitPrice       Decimal           @map("unit_price") @db.Decimal(12, 2)
  taxRate         Decimal           @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal           @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(12, 2)

  invoice         BrightloopInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("brightloop_invoice_items")
}

model DiscountRule {
  id              String                 @id @default(uuid()) @db.VarChar
  workspaceId     String                 @map("workspace_id") @db.VarChar
  code            String                 @unique @db.VarChar
  description     String?                @db.VarChar
  discountType    BrightloopDiscountType @default(PERCENTAGE) @map("discount_type")
  value           Decimal                @map("value") @db.Decimal(12, 2)
  minPurchase     Decimal                @default(0.00) @map("min_purchase") @db.Decimal(12, 2)
  minQuantity     Int                    @default(1) @map("min_quantity")
  startDate       DateTime?              @map("start_date") @db.Timestamptz(3)
  endDate         DateTime?              @map("end_date") @db.Timestamptz(3)
  maxUses         Int?                   @map("max_uses")
  currentUses     Int                    @default(0) @map("current_uses")
  appliesToAll    Boolean                @default(true) @map("applies_to_all")
  productId       String?                @map("product_id") @db.VarChar
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product?               @relation("ProductDiscounts", fields: [productId], references: [id], onDelete: SetNull)

  @@map("brightloop_discount_rules")
}

model PaymentRecord {
  id              String                  @id @default(uuid()) @db.VarChar
  invoiceId       String                  @map("invoice_id") @db.VarChar
  paymentNumber   String                  @unique @map("payment_number") @db.VarChar
  amount          Decimal                 @map("amount") @db.Decimal(12, 2)
  paymentDate     DateTime                @default(now()) @map("payment_date") @db.Timestamptz(3)
  paymentMethod   BrightloopPaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  referenceNumber String?                 @map("reference_number") @db.VarChar
  notes           String?                 @db.Text
  recordedById    String?                 @map("recorded_by_id") @db.VarChar
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice         BrightloopInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy      User?                   @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("brightloop_payment_records")
}


