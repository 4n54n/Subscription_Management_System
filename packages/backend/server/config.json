{
  "$schema": "../../../.docker/selfhost/schema.json",
  "oauth": {
    "providers": {
      "google": {
        "clientId": "",
        "clientSecret": ""
      },
      "github": {
        "clientId": "",
        "clientSecret": ""
      }
    }
  },
  "storages": {
    "blob.storage": {
      "provider": "fs",
      "bucket": "blobs",
      "config": {
        "path": "~/.affine/storage"
      }
    },
    "avatar.storage": {
      "provider": "fs",
      "bucket": "avatars",
      "config": {
        "path": "~/.affine/storage"
      }
    }
  }
}
