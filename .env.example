# ==============================================================================
# BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM - LOCAL DEV ENVIRONMENT (.env)
# ==============================================================================

# Database Connection (PostgreSQL on localhost:5433 placeholder)
DATABASE_URL="postgresql://postgres:password@localhost:5433/brightloop_subscriptions?schema=public"

# Redis Server
REDIS_SERVER_HOST=localhost
REDIS_SERVER_PORT=6379
REDIS_SERVER_PASSWORD=

# Server Environment & Hosts
NODE_ENV=development
PORT=3010
HOST=127.0.0.1
SERVER_HOST=localhost
SERVER_PORT=3010
SERVER_EXTERNAL_URL=http://localhost:3010

# Security & Secrets (Placeholders for local dev only)
JWT_SECRET="replace_with_a_secure_random_jwt_secret"
SESSION_SECRET="replace_with_a_secure_random_session_secret"

# Mailer Configuration (Local development / SMTP / SES placeholder)
MAILER_SENDER=noreply@brightloop.local
